class maprec{
	int kind;
	int minx, maxx, miny, maxy;
	string value;
	maprec(int k, int a, int b, int c, int d, string v){
		kind=k;
		minx=a;
		maxx=b;
		miny=c;
		maxy=d;
		value=v;
	}
}

class mapidx{
	string name;
	bool varinha;
	maprec@[] recs;
	mapidx(string n, bool v, maprec@[] r){
		name=n;
		varinha=v;
		recs=r;
	}
}

mapidx@[] allmaps;
int act_slot=-1;

void load_map_index(string mapname){
	maprec@[] recs;
	bool varinha=false;
	if(file_exists("maps/"+mapname+".map")){
		file f;
		f.open("maps/"+mapname+".map", "r");
		string[] lines=delinear(f.read());
		f.close();
		for(uint i=0; i<lines.length(); i++){
			if(lines[i].length()<1) continue;
			string[] p=string_split(lines[i], ":", false);
			if(p[0]=="desativar"){
				if(p.length()>1 && p[1]=="varinha") varinha=true;
				continue;
			}
			if(p[0]=="platform" && p.length()>4){
				maprec r1(1, string_to_number(p[1]), string_to_number(p[2]), string_to_number(p[3]), string_to_number(p[3]), p[4]);
				recs.insert_last(r1);
			}
			else if(p[0]=="staircase" && p.length()>5){
				maprec r2(2, string_to_number(p[1]), string_to_number(p[2]), string_to_number(p[3]), string_to_number(p[4]), p[5]);
				recs.insert_last(r2);
			}
			else if(p[0]=="wall" && p.length()>4){
				maprec r3(3, string_to_number(p[1]), string_to_number(p[1]), string_to_number(p[2]), string_to_number(p[3]), p[4]);
				recs.insert_last(r3);
			}
			else if(p[0]=="zone" && p.length()>5){
				maprec r4(4, string_to_number(p[1]), string_to_number(p[2]), string_to_number(p[3]), string_to_number(p[4]), p[5]);
				recs.insert_last(r4);
			}
			else if(p[0]=="safezone" && p.length()>4){
				maprec r5(5, string_to_number(p[1]), string_to_number(p[2]), string_to_number(p[3]), string_to_number(p[4]), "");
				recs.insert_last(r5);
			}
		}
	}
	mapidx m(mapname, varinha, recs);
	allmaps.insert_last(m);
	act_slot=allmaps.length()-1;
}

void ensure_map(string mapname){
	if(act_slot>=0 && act_slot<allmaps.length() && allmaps[act_slot].name==mapname) return;
	for(uint i=0; i<allmaps.length(); i++){
		if(allmaps[i].name==mapname){
			act_slot=i;
			return;
		}
	}
	load_map_index(mapname);
}

bool varinha_desativada(string m){
	ensure_map(m);
	return allmaps[act_slot].varinha;
}

string get_tile_at(int x, int y, string mapname, bool includeglobal=true){
	string outval;
	if(includeglobal==true){
		ensure_map(mapname);
		maprec@[] recs=allmaps[act_slot].recs;
		for(uint i=0; i<recs.length(); i++){
			if(recs[i].kind<1 || recs[i].kind>3) continue;
			if(recs[i].minx<=x && recs[i].maxx>=x && recs[i].miny<=y && recs[i].maxy>=y){
				outval=recs[i].value;
			}
		}
	}
	return outval;
}

string get_zone_at(int x, int y, string mapname, bool includeglobal=true){
	string outval;
	if(includeglobal==true){
		ensure_map(mapname);
		maprec@[] recs=allmaps[act_slot].recs;
		for(uint i=0; i<recs.length(); i++){
			if(recs[i].kind!=4) continue;
			if(recs[i].minx<=x && recs[i].maxx>=x && recs[i].miny<=y && recs[i].maxy>=y){
				outval=recs[i].value;
			}
		}
	}
	return outval;
}

string get_safezone_at(int x, int y, string mapname, bool includeglobal=true){
	string outval;
	if(includeglobal==true){
		ensure_map(mapname);
		maprec@[] recs=allmaps[act_slot].recs;
		for(uint i=0; i<recs.length(); i++){
			if(recs[i].kind!=5) continue;
			if(recs[i].minx<=x && recs[i].maxx>=x && recs[i].miny<=y && recs[i].maxy>=y) return true;
		}
	}
	return false;
}

string linear(string[] a){
	string final;
	for(uint i=0; i<a.length(); i++)
	{
		final+=(a[i]+"\r\n");
	}
	return final;
}

string[] delinear(string a){
	return string_split(a, "\r\n", false);
}
